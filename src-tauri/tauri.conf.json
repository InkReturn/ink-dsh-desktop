{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inkdsh",
  "version": "0.1.0",
  "identifier": "com.inkdsh.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "inkdsh",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "url": "waiting.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/runtime/": "runtime/"
    }
  }
}
