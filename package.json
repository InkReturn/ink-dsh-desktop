{
  "name": "inkdsh",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "inkdsh — a fast, multi-host desktop client for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:offline": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/stage-runtime.ps1 -Force && tauri build",
    "runtime:stage": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/stage-runtime.ps1",
    "tauri": "tauri",
    "plugins:typecheck": "pnpm -r --filter \"./plugins/*\" typecheck",
    "plugins:test": "pnpm -r --filter \"./plugins/*\" test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
