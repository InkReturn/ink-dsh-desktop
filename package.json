    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-stats": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-turn-outline": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
